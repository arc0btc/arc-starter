[Unit]
Description=arc-agent sensors runner
After=network.target

[Service]
Type=oneshot
WorkingDirectory=/home/dev/arc-starter
ExecStart=/home/dev/.bun/bin/bun src/cli.ts sensors
Environment="HOME=/home/dev"
Environment="PATH=/usr/local/bin:/usr/bin:/bin:/home/dev/.bun/bin:/home/dev/.local/bin"
EnvironmentFile=/home/dev/arc-starter/.env
StandardOutput=journal
StandardError=journal
# Outage-hardening (2026-07-19, phase 9 of arc-x-research-channel): the 2026-07-17->07-19
# ~46h monsoon outage left this unit's run hung (gh calls spinning against unreachable
# api.github.com) and its 1-min timer (Persistent=no) never re-fired. An OS-level backstop is
# needed because it's independent of any JS-level timeout in the code (which cannot rescue a
# synchronous Bun.spawnSync hang since that blocks the single JS event loop).
#
# CORRECTION during live verify: RuntimeMaxSec= was tried first per the original plan, but
# systemd 255 logs "RuntimeMaxSec= has no effect in combination with Type=oneshot. Ignoring."
# (confirmed live via journalctl on this exact unit) -- it is a silent no-op for oneshot
# services on this systemd version. TimeoutStartSec= is the directive systemd actually honors
# for oneshot (this is also why arc-dispatch.service's pre-existing TimeoutStartSec=3600 was a
# real, working backstop pre-incident, while an add-RuntimeMaxSec-only fix here would have
# shipped a backstop that silently does nothing).
#
# Bound chosen from 30d journalctl Starting->Finished wall-clock data: p99=119s, worst normal
# run (excluding the incident) = 166s. 600s gives 3.6x headroom over the worst normal run while
# killing any hang within 10 minutes instead of days.
TimeoutStartSec=600
TimeoutStopSec=60

# SCOPE CORRECTION (dev-council Lamport lens, 2026-07-19): TimeoutStartSec bounds wall-clock
# from ExecStart to job-settle and, on expiry, SIGTERMs then (after TimeoutStopSec) SIGKILLs the
# unit's cgroup -- for a process in an INTERRUPTIBLE wait (the documented incident: gh blocked
# on a TCP call to an unreachable host, S-state) this reliably reaps it and frees the timer to
# re-fire. It is NOT a guarantee against a process wedged in an UNINTERRUPTIBLE kernel wait
# (D-state -- e.g. a dying disk/NFS/FUSE path, plausible during a chaotic power-transition,
# though not what a network hang produces): SIGKILL cannot reap D-state, the unit can hang in
# stop-sigterm/final-sigkill with a non-empty cgroup, and the timer never re-arms. Do not read
# this directive as "kills any hang" -- it kills any SIGNAL-REAPABLE hang, which covers the
# incident as diagnosed. The off-LAN arc-heartbeat-worker (see ops/systemd/arc-heartbeat.*) is
# the actual backstop for a fully wedged VM.
